---
const testimonials = [
  {
    name: 'Mariela Castro',
    role: 'Novia (Boda en Guanacaste)',
    location: 'Hacienda Pinilla',
    text: 'Contratamos el Paquete Paraíso Tropical para nuestra boda y superó todas las expectativas. Las copas tiki de cerámica y la barra de bambú iluminada fueron el centro de atención. Los cocteles de maracuyá y los mojitos de fresa estaban fresquísimos. ¡Servicio impecable!',
    stars: 5,
    initials: 'MC',
    gradient: 'from-tiki-palm/10 to-transparent'
  },
  {
    name: 'Alejandro Herrera',
    role: 'Organizador (Evento Corporativo)',
    location: 'Escazú, San José',
    text: 'Increíble profesionalismo. Contratamos el Paquete Fuego Tribal para nuestra fiesta de fin de año corporativa. La velocidad del servicio de los dos bartenders y la calidad del Cacique Sour y el Chiliguaro premium mantuvieron a todo el equipo encantado. Totalmente recomendados.',
    stars: 5,
    initials: 'AH',
    gradient: 'from-tiki-orange/10 to-transparent'
  },
  {
    name: 'Valeria Solís',
    role: 'Cumpleañera (Fiesta de 30 Años)',
    location: 'Jacó, Puntarenas',
    text: 'La mejor decisión para mi cumpleaños en la playa. El servicio de Tiki House trajo una vibra espectacular con su decoración de máscaras de madera y luces de neón. El Guaro Tiki es una delicia que todos siguieron comentando días después. ¡El trato es de primer nivel!',
    stars: 5,
    initials: 'VS',
    gradient: 'from-tiki-yellow/10 to-transparent'
  }
];
---

<section id="testimonios" class="py-24 px-4 md:px-8 relative bg-[#0B1510] overflow-hidden">
  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="text-xs font-extrabold uppercase tracking-widest text-tiki-yellow bg-tiki-yellow/15 border border-tiki-yellow/20 px-3.5 py-1 rounded-full inline-block">
        Opiniones Reales
      </span>
      <h2 class="text-4xl md:text-5xl font-extrabold text-tiki-textMain tracking-tight">
        Lo que Dicen Nuestros Clientes
      </h2>
      <p class="text-base md:text-lg text-tiki-textSec font-normal leading-relaxed">
        La satisfacción de quienes confían en nosotros es nuestra mejor carta de presentación. Conoce sus experiencias con nuestro servicio de barra móvil.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
      {testimonials.map((test) => (
        <div class={`rounded-3xl p-8 bg-tiki-dark border border-tiki-soft/10 bg-gradient-to-tr ${test.gradient} flex flex-col justify-between h-full transition-transform duration-300 hover:-translate-y-1`}>
          <!-- Quote Icon -->
          <div class="mb-6 flex justify-between items-start">
            <svg class="w-10 h-10 text-tiki-palm/30" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
            
            <!-- Stars Rating -->
            <div class="flex space-x-1">
              {Array.from({ length: test.stars }).map(() => (
                <svg class="w-4 h-4 text-tiki-yellow fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
          </div>

          <!-- Text -->
          <p class="text-sm text-tiki-textSec font-normal leading-relaxed mb-8 italic">
            "{test.text}"
          </p>

          <!-- Client Profile -->
          <div class="flex items-center space-x-4 pt-6 border-t border-white/5">
            <!-- Initials Avatar -->
            <div class="w-12 h-12 rounded-full bg-tiki-forest flex items-center justify-center border border-tiki-palm/30 text-tiki-palm font-bold tracking-wider text-sm flex-shrink-0">
              {test.initials}
            </div>
            
            <div>
              <h4 class="text-sm font-bold text-tiki-textMain">{test.name}</h4>
              <p class="text-xs text-tiki-textSec font-normal">{test.role}</p>
              <span class="inline-flex items-center text-[10px] text-tiki-palm font-semibold mt-0.5">
                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                {test.location}
              </span>
            </div>
          </div>

        </div>
      ))}
    </div>
  </div>
</section>
