---
import Logo from './Logo.astro';
---
<section id="inicio" class="relative min-h-screen flex items-center justify-center pt-28 pb-16 overflow-hidden bg-tiki-bg">
  <!-- Interactive background lines (colores oficiales de marca) -->
  <div class="absolute inset-0 z-0 opacity-10 pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-[1px] h-96 bg-gradient-to-b from-tiki-primary to-transparent"></div>
    <div class="absolute top-1/3 right-1/4 w-[1px] h-96 bg-gradient-to-b from-tiki-accent to-transparent"></div>
    <div class="absolute bottom-10 left-1/2 w-96 h-[1px] bg-gradient-to-r from-transparent via-tiki-gold to-transparent"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Content Column -->
      <div class="lg:col-span-7 flex flex-col justify-center text-left">
        <!-- Brand identity section -->
        <div class="space-y-4">
          <!-- Logo principal en Hero -->
          <div class="inline-block transform hover:scale-105 transition-transform duration-300">
            <Logo variant="full" width={75} height={75} />
          </div>

          <!-- Floating Tagline -->
          <div class="flex">
            <div class="inline-flex items-center space-x-2 bg-tiki-secondary/30 border border-tiki-primary/30 px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider text-tiki-primary">
              <span class="w-1.5 h-1.5 rounded-full bg-tiki-primary animate-pulse"></span>
              <span>Pura Vida Coctelería Premium</span>
            </div>
          </div>

          <!-- Title -->
          <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tight leading-[1.05] text-tiki-text pt-2">
            Tiki House <br />
            <span class="text-gradient-primary">Costa Rica</span>
          </h1>
        </div>

        <!-- Subtitle and details -->
        <div class="mt-6 space-y-6">
          <p class="text-lg md:text-xl text-tiki-text-sec font-normal max-w-2xl leading-relaxed">
            Coctelería tropical para eventos, fiestas privadas y celebraciones inolvidables. Llevamos barras móviles temáticas y el auténtico sabor exótico directo a tu fiesta.
          </p>

        <!-- Bullet Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-xl">
          <div class="flex items-center space-x-3 text-tiki-text-sec text-sm">
            <svg class="w-5 h-5 text-tiki-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Barras Móviles Temáticas Tiki</span>
          </div>
          <div class="flex items-center space-x-3 text-tiki-text-sec text-sm">
            <svg class="w-5 h-5 text-tiki-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Bartenders Profesionales</span>
          </div>
          <div class="flex items-center space-x-3 text-tiki-text-sec text-sm">
            <svg class="w-5 h-5 text-tiki-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Frutas y Almíbares 100% Naturales</span>
          </div>
          <div class="flex items-center space-x-3 text-tiki-text-sec text-sm">
            <svg class="w-5 h-5 text-tiki-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Atención Personalizada en Todo el País</span>
          </div>
        </div>

        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <!-- Botón Primario: fondo verde tropical, texto oscuro -->
          <a 
            href="#cocteles" 
            class="px-8 py-4 rounded-xl bg-tiki-primary text-tiki-bg font-bold text-center tracking-wide hover:bg-tiki-primary-hover shadow-[0_0_20px_rgba(0,177,137,0.25)] hover:shadow-[0_0_30px_rgba(0,177,137,0.45)] transition-all duration-300 transform hover:-translate-y-0.5"
          >
            Ver cocteles
          </a>
          <!-- Botón Secundario: borde verde, texto verde, fondo transparente -->
          <a 
            href="#contacto" 
            class="px-8 py-4 rounded-xl border-2 border-tiki-primary/40 text-tiki-primary font-bold text-center tracking-wide hover:bg-tiki-primary/10 hover:border-tiki-primary transition-all duration-300 transform hover:-translate-y-0.5"
          >
            Solicitar cotización
          </a>
        </div>
      </div>
    </div>

      <!-- Visual Column: Hero Image -->
      <div class="lg:col-span-5 flex justify-center items-center relative">
        <!-- Background glow -->
        <div class="absolute w-80 h-80 rounded-full bg-tiki-primary/10 blur-[100px] animate-pulse -z-10"></div>
        
        <!--
          ╔══════════════════════════════════════════════════════════════╗
          ║  IMAGEN HERO                                                ║
          ║  Subir imagen a: /public/images/hero-cocktail.png           ║
          ║  Tamaño recomendado: 800x1000px, formato .png o .webp       ║
          ║  Ideal: foto de un coctel tropical o barra tiki             ║
          ╚══════════════════════════════════════════════════════════════╝
        -->
        <div class="relative w-72 h-[400px] md:w-80 md:h-[450px] rounded-3xl glassmorphism flex flex-col justify-center items-center overflow-hidden border border-tiki-primary/20 group">
          <!-- Pattern Overlay -->
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-tiki-secondary/10 via-transparent to-transparent"></div>
          
          <!-- Hero Image -->
          <img 
            src="/images/hero-cocktail.png" 
            alt="Coctel tropical premium de Tiki House Costa Rica" 
            class="w-full h-full object-cover rounded-3xl transition-transform duration-700 group-hover:scale-105"
            loading="eager"
          />
          
          <!-- Neon Badge -->
          <div class="absolute bottom-6 bg-tiki-bg/80 px-4 py-1.5 rounded-full border border-tiki-primary/30 text-xs font-bold text-tiki-primary tracking-widest uppercase shadow-[0_0_10px_rgba(0,177,137,0.15)] animate-pulse">
            Premium Bar Service
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>
