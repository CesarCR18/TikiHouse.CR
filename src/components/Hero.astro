---
---
<section id="inicio" class="relative min-h-screen flex items-center justify-center pt-28 pb-16 overflow-hidden bg-tiki-dark">
  <!-- Interactive background lines & patterns -->
  <div class="absolute inset-0 z-0 opacity-10 pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-[1px] h-96 bg-gradient-to-b from-tiki-palm to-transparent"></div>
    <div class="absolute top-1/3 right-1/4 w-[1px] h-96 bg-gradient-to-b from-tiki-orange to-transparent"></div>
    <div class="absolute bottom-10 left-1/2 w-96 h-[1px] bg-gradient-to-r from-transparent via-tiki-yellow to-transparent"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Content Column -->
      <div class="lg:col-span-7 space-y-8 text-left">
        <!-- Floating Tagline -->
        <div class="inline-flex items-center space-x-2 bg-tiki-forest/30 border border-tiki-palm/30 px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider text-tiki-palm">
          <span class="w-1.5 h-1.5 rounded-full bg-tiki-palm animate-pulse"></span>
          <span>Pura Vida Coctelería Premium</span>
        </div>

        <!-- Title -->
        <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tight leading-[1.05] text-tiki-textMain">
          Tiki House <br />
          <span class="text-gradient-palm-yellow">Costa Rica</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg md:text-xl text-tiki-textSec font-normal max-w-2xl leading-relaxed">
          Coctelería tropical para eventos, fiestas privadas y celebraciones inolvidables. Llevamos barras móviles temáticas y el auténtico sabor exótico directo a tu fiesta.
        </p>

        <!-- Bullet Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-xl">
          <div class="flex items-center space-x-3 text-tiki-textSec text-sm">
            <svg class="w-5 h-5 text-tiki-palm flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Barras Móviles Temáticas Tiki</span>
          </div>
          <div class="flex items-center space-x-3 text-tiki-textSec text-sm">
            <svg class="w-5 h-5 text-tiki-palm flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Bartenders Profesionales</span>
          </div>
          <div class="flex items-center space-x-3 text-tiki-textSec text-sm">
            <svg class="w-5 h-5 text-tiki-palm flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Frutas y Almíbares 100% Naturales</span>
          </div>
          <div class="flex items-center space-x-3 text-tiki-textSec text-sm">
            <svg class="w-5 h-5 text-tiki-palm flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Atención Personalizada en Todo el País</span>
          </div>
        </div>

        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <a 
            href="#cocteles" 
            class="px-8 py-4 rounded-xl bg-tiki-palm text-tiki-dark font-bold text-center tracking-wide hover:bg-tiki-palm/90 shadow-[0_0_20px_rgba(45,212,126,0.25)] hover:shadow-[0_0_30px_rgba(45,212,126,0.45)] transition-all duration-300 transform hover:-translate-y-0.5"
          >
            Ver cocteles
          </a>
          <a 
            href="#contacto" 
            class="px-8 py-4 rounded-xl border-2 border-tiki-soft/20 text-tiki-textMain font-bold text-center tracking-wide hover:bg-tiki-soft/10 hover:border-tiki-palm/40 transition-all duration-300 transform hover:-translate-y-0.5"
          >
            Solicitar cotización
          </a>
        </div>
      </div>

      <!-- visual Column (CSS Art) -->
      <div class="lg:col-span-5 flex justify-center items-center relative">
        <!-- background Glow for visual -->
        <div class="absolute w-80 h-80 rounded-full bg-tiki-palm/10 blur-[100px] animate-pulse -z-10"></div>
        
        <!-- Glowing Cocktail / Tiki Art Frame -->
        <div class="relative w-72 h-[400px] md:w-80 md:h-[450px] rounded-3xl glassmorphism flex flex-col justify-center items-center overflow-hidden border border-tiki-palm/20 group">
          <!-- Pattern Overlay -->
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-tiki-forest/10 via-transparent to-transparent"></div>
          
          <!-- Elegant Cocktail Glass CSS Art -->
          <div class="relative flex flex-col items-center justify-center space-y-4">
            <!-- Neon fluid splash -->
            <div class="absolute -top-6 w-32 h-32 rounded-full bg-gradient-to-tr from-tiki-orange/30 to-tiki-yellow/30 blur-2xl group-hover:scale-125 transition-transform duration-700"></div>

            <!-- Glass shape -->
            <div class="w-32 h-44 rounded-t-sm rounded-b-3xl border-2 border-tiki-soft/40 relative flex items-end justify-center overflow-hidden shadow-[0_0_20px_rgba(167,243,208,0.05)] bg-white/5">
              <!-- Liquid -->
              <div class="w-full h-[70%] bg-gradient-to-t from-tiki-orange to-tiki-yellow relative flex items-center justify-center animate-bounce duration-[3000ms]">
                <!-- Bubble animations inside liquid -->
                <div class="absolute w-1.5 h-1.5 rounded-full bg-white/40 bottom-4 left-6 animate-ping"></div>
                <div class="absolute w-2 h-2 rounded-full bg-white/30 bottom-10 right-8 animate-ping delay-500"></div>
                <div class="absolute w-1 h-1 rounded-full bg-white/50 bottom-16 left-12 animate-ping delay-1000"></div>
              </div>
              
              <!-- Lime Slice on the Rim -->
              <div class="absolute top-10 right-4 w-12 h-12 rounded-full border border-tiki-palm/50 bg-tiki-palm/20 flex items-center justify-center rotate-45 transform hover:scale-110 transition-transform duration-300">
                <div class="w-10 h-10 rounded-full border border-tiki-palm/25 flex items-center justify-center">
                  <div class="w-1 h-8 bg-tiki-palm/35 absolute"></div>
                  <div class="w-8 h-1 bg-tiki-palm/35 absolute"></div>
                </div>
              </div>

              <!-- Straw -->
              <div class="absolute -top-10 left-[45%] w-2.5 h-48 bg-gradient-to-b from-tiki-palm via-tiki-soft to-tiki-forest rounded-full -rotate-12 shadow-lg"></div>
            </div>
            
            <!-- Stem and Base -->
            <div class="w-3.5 h-20 bg-tiki-soft/30 shadow-[0_0_10px_rgba(167,243,208,0.1)]"></div>
            <div class="w-24 h-2 bg-tiki-soft/40 rounded-full"></div>
          </div>
          
          <!-- Neon Badge -->
          <div class="absolute bottom-6 bg-tiki-dark/80 px-4 py-1.5 rounded-full border border-tiki-palm/30 text-xs font-bold text-tiki-palm tracking-widest uppercase shadow-[0_0_10px_rgba(45,212,126,0.15)] animate-pulse">
            Premium Bar Service
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>
