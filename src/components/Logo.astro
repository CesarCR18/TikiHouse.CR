---
interface Props {
  variant?: 'full' | 'icon';
  class?: string;
  width?: string | number;
  height?: string | number;
}

const {
  variant = 'full',
  class: className = '',
  width,
  height,
} = Astro.props;
---

<div class={`inline-flex items-center select-none ${className}`}>
  <!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  LOGO DE TIKI HOUSE                                         ║
    ║  Subir la imagen del logo a: /public/images/logo-tiki-house.png  ║
    ║  Formatos aceptados: .png, .svg, .webp                     ║
    ║  Tamaño recomendado: mínimo 400x400px para buena calidad   ║
    ╚══════════════════════════════════════════════════════════════╝
  -->
  <div class="flex items-center space-x-3 md:space-x-4">
    <!-- Imagen del Logo -->
    <div 
      class="relative flex-shrink-0"
      style={{ 
        width: width ? `${width}px` : '48px', 
        height: height ? `${height}px` : '48px' 
      }}
    >
      <img
        src="/images/logo-tiki-house.png"
        alt="Tiki House CR Logo"
        width={width}
        height={height}
        class="w-full h-full object-contain drop-shadow-[0_4px_12px_rgba(0,177,137,0.25)]"
        loading="eager"
      />
    </div>

    {/* Typography portion of Logo */}
    {variant === 'full' && (
      <div class="flex flex-col justify-center select-none leading-none">
        <span class="text-xl md:text-2xl font-black tracking-tight text-white font-display uppercase">
          Tiki House
        </span>
        <div class="flex items-center space-x-1.5 mt-0.5">
          <span class="text-[9px] md:text-[10px] font-bold tracking-[0.2em] text-tiki-primary uppercase">
            Costa Rica
          </span>
          <span class="text-[8px] font-extrabold px-1.5 py-0.5 rounded bg-tiki-secondary/60 text-tiki-text border border-tiki-primary/20 uppercase tracking-widest leading-none">
            CR
          </span>
        </div>
      </div>
    )}
  </div>
</div>
