---
import type { Cocktail } from '../data/cocktails';

interface Props {
  cocktail: Cocktail;
}

const { cocktail } = Astro.props;
---

<div class={`relative rounded-3xl p-6 bg-gradient-to-br ${cocktail.gradient} border flex flex-col justify-between h-full transition-all duration-300 group hover:-translate-y-1.5 hover:shadow-[0_10px_30px_rgba(5,8,7,0.8)] backdrop-blur-sm`}>
  <!-- Top Section (Icon & Badge) -->
  <div class="flex items-start justify-between mb-6">
    <div class="p-3.5 rounded-2xl bg-tiki-dark/60 border border-white/5 transition-transform duration-300 group-hover:scale-110">
      {cocktail.id.includes('mojito') && (
        <svg class="w-12 h-12 md:w-14 md:h-14 text-tiki-palm/60 group-hover:text-tiki-palm transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M7 3h10v16a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V3Z" />
          <path d="M7 6h10" />
          <path d="M12 3v13" stroke-dasharray="2 2" />
          <circle cx="10" cy="11" r="1.5" fill="currentColor" class="opacity-40" />
          <circle cx="14" cy="8" r="1" fill="currentColor" class="opacity-40" />
        </svg>
      )}
      {cocktail.id.includes('pina') && (
        <svg class="w-12 h-12 md:w-14 md:h-14 text-tiki-yellow/60 group-hover:text-tiki-yellow transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M8 3h8v4c0 3-1.5 5-1.5 7v3a2.5 2.5 0 0 1-5 0v-3C9.5 12 8 10 8 7V3Z" />
          <path d="M12 17v4" />
          <path d="M9 21h6" />
          <line x1="16" y1="3" x2="19" y2="1" />
        </svg>
      )}
      {cocktail.id.includes('margarita') && (
        <svg class="w-12 h-12 md:w-14 md:h-14 text-tiki-orange/60 group-hover:text-tiki-orange transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 3h12v3c0 3-4 4-4 6v5" />
          <path d="M6 6c0 3 4 4 4 6" />
          <path d="M12 17v4" />
          <path d="M9 21h6" />
          <line x1="14" y1="3" x2="16" y2="1" />
        </svg>
      )}
      {(cocktail.id.includes('sour') || cocktail.id.includes('chili')) && (
        <svg class="w-12 h-12 md:w-14 md:h-14 text-tiki-soft/60 group-hover:text-tiki-soft transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M8 4h8v10a4 4 0 0 1-8 0V4Z" />
          <path d="M12 14v5" />
          <path d="M9 19h6" />
          <line x1="8" y1="8" x2="16" y2="8" />
        </svg>
      )}
      {!cocktail.id.includes('mojito') && !cocktail.id.includes('pina') && !cocktail.id.includes('margarita') && !cocktail.id.includes('sour') && !cocktail.id.includes('chili') && (
        <svg class="w-12 h-12 md:w-14 md:h-14 text-tiki-textSec/60 group-hover:text-tiki-textMain transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 4h10v14a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3V4Z" />
          <path d="M16 8h2a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2" />
          <line x1="6" y1="6" x2="16" y2="6" />
        </svg>
      )}
    </div>
    
    <div class="flex flex-col items-end space-y-2">
      <!-- Category Badge -->
      <span class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded bg-tiki-dark/80 text-tiki-textSec border border-white/5">
        {cocktail.category}
      </span>
      
      <!-- Alcohol Content Badge -->
      <span class={`text-[10px] font-extrabold tracking-wider px-2 py-0.5 rounded ${cocktail.hasAlcohol ? 'bg-tiki-orange/15 text-tiki-orange border border-tiki-orange/20' : 'bg-tiki-palm/15 text-tiki-palm border border-tiki-palm/20'}`}>
        {cocktail.hasAlcohol ? 'Con Alcohol' : 'Sin Alcohol'}
      </span>
    </div>
  </div>

  <!-- Middle Section (Text) -->
  <div class="flex-grow flex flex-col justify-between">
    <div>
      <h3 class="text-xl font-bold text-tiki-textMain mb-2 group-hover:text-tiki-palm transition-colors duration-300">
        {cocktail.name}
      </h3>
      <p class="text-sm text-tiki-textSec leading-relaxed mb-6 font-normal">
        {cocktail.description}
      </p>
    </div>

    <!-- Bottom Section (Tags) -->
    <div class="flex flex-wrap gap-1.5 pt-4 border-t border-white/5">
      {cocktail.tags.map((tag) => (
        <span class="text-xs font-medium px-2 py-0.5 rounded-md bg-tiki-forest/20 text-tiki-soft border border-tiki-soft/10">
          #{tag}
        </span>
      ))}
    </div>
  </div>
</div>
