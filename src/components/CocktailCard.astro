---
import type { Cocktail } from '../data/cocktails';

interface Props {
  cocktail: Cocktail;
}

const { cocktail } = Astro.props;
---

<div class={`relative rounded-3xl p-6 bg-tiki-card border border-tiki-primary/15 flex flex-col justify-between h-full transition-all duration-300 group hover:-translate-y-1.5 hover:shadow-[0_10px_30px_rgba(0,177,137,0.12)] hover:border-tiki-primary/35 backdrop-blur-sm`}>

  <!-- Top Section (Image & Badge) -->
  <div class="flex items-start justify-between mb-6">
    <!--
      ╔══════════════════════════════════════════════════════════════╗
      ║  IMAGEN DEL COCTEL                                          ║
      ║  Subir imagen a: /public/images/cocktails/{cocktail.id}.png ║
      ║  Tamaño recomendado: 200x200px, formato .png o .webp        ║
      ╚══════════════════════════════════════════════════════════════╝
    -->
    <div class="p-2 rounded-2xl bg-tiki-bg/60 border border-tiki-primary/10 transition-transform duration-300 group-hover:scale-110 overflow-hidden">
      <img 
        src={`/images/cocktails/${cocktail.id}.png`}
        alt={cocktail.name}
        class="w-12 h-12 md:w-14 md:h-14 object-cover rounded-xl"
        loading="lazy"
      />
    </div>
    
    <div class="flex flex-col items-end space-y-2">
      <!-- Category Badge -->
      <span class="text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded bg-tiki-bg/80 text-tiki-text-sec border border-tiki-primary/10">
        {cocktail.category}
      </span>
      
      <!-- Alcohol Content Badge -->
      <span class={`text-[10px] font-extrabold tracking-wider px-2 py-0.5 rounded ${cocktail.hasAlcohol ? 'bg-tiki-accent/15 text-tiki-accent border border-tiki-accent/20' : 'bg-tiki-primary/15 text-tiki-primary border border-tiki-primary/20'}`}>
        {cocktail.hasAlcohol ? 'Con Alcohol' : 'Sin Alcohol'}
      </span>
    </div>
  </div>

  <!-- Middle Section (Text) -->
  <div class="flex-grow flex flex-col justify-between">
    <div>
      <h3 class="text-xl font-bold text-tiki-text mb-2 group-hover:text-tiki-primary transition-colors duration-300">
        {cocktail.name}
      </h3>
      <p class="text-sm text-tiki-text-sec leading-relaxed mb-6 font-normal">
        {cocktail.description}
      </p>
    </div>

    <!-- Bottom Section (Tags) -->
    <div class="flex flex-wrap gap-1.5 pt-4 border-t border-tiki-primary/10">
      {cocktail.tags.map((tag) => (
        <span class="text-xs font-medium px-2 py-0.5 rounded-md bg-tiki-secondary/20 text-tiki-text-sec border border-tiki-primary/10">
          #{tag}
        </span>
      ))}
    </div>
  </div>
</div>
