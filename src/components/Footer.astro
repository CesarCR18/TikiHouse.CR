---
const currentYear = new Date().getFullYear();
---

<footer class="bg-tiki-dark border-t border-tiki-soft/10 py-16 px-4 md:px-8 relative overflow-hidden">
  <!-- Small background glow -->
  <div class="absolute bottom-0 right-[15%] w-72 h-72 bg-tiki-palm/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8 items-start mb-12">
      
      <!-- Brand Details -->
      <div class="md:col-span-5 space-y-4">
        <a href="#inicio" class="flex items-center space-x-2 group">
          <span class="text-2xl md:text-3xl font-extrabold tracking-tighter text-gradient-palm-yellow">
            TIKI HOUSE BAR
          </span>
        </a>
        <p class="text-sm text-tiki-textSec font-normal max-w-sm leading-relaxed">
          Coctelería para eventos en Costa Rica. Llevamos barras móviles tropicales, bartenders certificados y el mejor ambiente exótico directamente a tu celebración.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="md:col-span-4 space-y-4">
        <h4 class="text-xs font-bold text-tiki-textMain uppercase tracking-widest">Navegación</h4>
        <div class="grid grid-cols-2 gap-2.5">
          <a href="#inicio" class="text-sm text-tiki-textSec hover:text-tiki-palm transition-colors duration-200">Inicio</a>
          <a href="#cocteles" class="text-sm text-tiki-textSec hover:text-tiki-palm transition-colors duration-200">Cocteles</a>
          <a href="#paquetes" class="text-sm text-tiki-textSec hover:text-tiki-palm transition-colors duration-200">Paquetes</a>
          <a href="#sobre-nosotros" class="text-sm text-tiki-textSec hover:text-tiki-palm transition-colors duration-200">Sobre Nosotros</a>
          <a href="#galeria" class="text-sm text-tiki-textSec hover:text-tiki-palm transition-colors duration-200">Galería</a>
          <a href="#contacto" class="text-sm text-tiki-textSec hover:text-tiki-palm transition-colors duration-200">Contacto</a>
        </div>
      </div>

      <!-- Social Media & Contact Info -->
      <div class="md:col-span-3 space-y-4">
        <h4 class="text-xs font-bold text-tiki-textMain uppercase tracking-widest">Síguenos</h4>
        <div class="flex space-x-4">
          <!-- Instagram -->
          <a 
            href="https://www.instagram.com/tikihouse.cr/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-2.5 rounded-xl bg-tiki-card border border-tiki-soft/10 text-tiki-textSec hover:text-tiki-palm hover:border-tiki-palm/40 transition-all duration-300"
            aria-label="Sigue a Tiki House Costa Rica en Instagram"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <!-- Facebook Placeholder -->
          <a 
            href="https://facebook.com/tikihouse.cr" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-2.5 rounded-xl bg-tiki-card border border-tiki-soft/10 text-tiki-textSec hover:text-tiki-palm hover:border-tiki-palm/40 transition-all duration-300"
            aria-label="Sigue a Tiki House Costa Rica en Facebook"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
            </svg>
          </a>
          <!-- WhatsApp / Chat -->
          <a 
            href="https://wa.me/50688888888" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-2.5 rounded-xl bg-tiki-card border border-tiki-soft/10 text-tiki-textSec hover:text-tiki-palm hover:border-tiki-palm/40 transition-all duration-300"
            aria-label="Escríbenos por WhatsApp"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
          </a>
        </div>
        <p class="text-xs text-tiki-textSec/60">
          Ubicación: San José, Costa Rica <br />
          Cobertura: Todo el territorio nacional
        </p>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="border-t border-white/5 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-tiki-textSec/50">
      <p>© {currentYear} Tiki House Costa Rica. Todos los derechos reservados.</p>
      <div class="flex space-x-6">
        <a href="#contacto" class="hover:text-tiki-palm transition-colors duration-200">Políticas de Reservación</a>
        <span class="text-white/5">|</span>
        <a href="#inicio" class="hover:text-tiki-palm transition-colors duration-200">Volver arriba</a>
      </div>
    </div>
  </div>
</footer>
