---
---
<section id="sobre-nosotros" class="py-24 px-4 md:px-8 relative bg-tiki-dark overflow-hidden">
  <!-- Neon green grid line style backdrop -->
  <div class="absolute inset-y-0 right-0 w-1/3 opacity-[0.03] pointer-events-none -z-10 bg-[linear-gradient(to_right,#2DD47E_1px,transparent_1px),linear-gradient(to_bottom,#2DD47E_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Visual Column (CSS Tiki Art) -->
      <div class="lg:col-span-5 order-2 lg:order-1 flex justify-center relative">
        <div class="absolute w-72 h-72 rounded-full bg-tiki-orange/5 blur-[90px] pointer-events-none"></div>
        
        <!-- Tiki Mask CSS Frame -->
        <div class="relative w-64 h-[380px] rounded-[40px] bg-gradient-to-b from-[#0F2218] to-tiki-dark border border-tiki-palm/15 shadow-[0_15px_40px_rgba(5,8,7,0.7)] flex flex-col items-center justify-between p-8 overflow-hidden group">
          <!-- Inner glows -->
          <div class="absolute top-1/4 w-32 h-32 bg-tiki-orange/15 rounded-full blur-2xl group-hover:scale-125 transition-transform duration-700"></div>
          
          <!-- Tribal Line Accents (Mask structure) -->
          <div class="w-full flex flex-col items-center space-y-6 relative z-10">
            <!-- Top Crown -->
            <div class="flex space-x-1.5 justify-center">
              <div class="w-2 h-8 bg-tiki-orange/40 rounded-full transform -rotate-12"></div>
              <div class="w-2.5 h-12 bg-tiki-orange/60 rounded-full"></div>
              <div class="w-3 h-14 bg-tiki-palm/80 rounded-full shadow-[0_0_10px_rgba(45,212,126,0.3)]"></div>
              <div class="w-2.5 h-12 bg-tiki-orange/60 rounded-full"></div>
              <div class="w-2 h-8 bg-tiki-orange/40 rounded-full transform rotate-12"></div>
            </div>

            <!-- Glowing Tiki Eyes -->
            <div class="flex space-x-8 justify-center w-full pt-4">
              <!-- Left Eye -->
              <div class="w-12 h-8 rounded-full border border-tiki-palm/40 bg-tiki-dark flex items-center justify-center relative shadow-[inset_0_0_10px_rgba(45,212,126,0.2)]">
                <div class="w-3 h-3 rounded-full bg-tiki-palm shadow-[0_0_10px_#2DD47E]"></div>
                <!-- Eyebrow -->
                <div class="absolute -top-3 w-10 h-1 bg-tiki-palm/60 rounded-full -rotate-12"></div>
              </div>
              <!-- Right Eye -->
              <div class="w-12 h-8 rounded-full border border-tiki-palm/40 bg-tiki-dark flex items-center justify-center relative shadow-[inset_0_0_10px_rgba(45,212,126,0.2)]">
                <div class="w-3 h-3 rounded-full bg-tiki-palm shadow-[0_0_10px_#2DD47E]"></div>
                <!-- Eyebrow -->
                <div class="absolute -top-3 w-10 h-1 bg-tiki-palm/60 rounded-full rotate-12"></div>
              </div>
            </div>

            <!-- Tiki Nose -->
            <div class="w-5 h-16 bg-gradient-to-b from-tiki-palm/35 to-tiki-orange/40 rounded-full relative flex justify-center">
              <div class="absolute -bottom-1 w-8 h-2 bg-tiki-orange/50 rounded-full"></div>
            </div>

            <!-- Glowing Tiki Mouth (Tribal grin) -->
            <div class="w-32 h-14 rounded-b-3xl rounded-t-lg border-2 border-tiki-orange/50 bg-tiki-dark/80 relative overflow-hidden flex flex-col justify-center items-center shadow-[inset_0_0_10px_rgba(249,115,22,0.3)]">
              <!-- Teeth cuts -->
              <div class="w-28 h-0.5 bg-tiki-orange/30 absolute"></div>
              <div class="flex justify-between w-24">
                <div class="w-1 h-3 bg-tiki-orange/40"></div>
                <div class="w-1 h-3 bg-tiki-orange/40"></div>
                <div class="w-1 h-3 bg-tiki-orange/40"></div>
                <div class="w-1 h-3 bg-tiki-orange/40"></div>
                <div class="w-1 h-3 bg-tiki-orange/40"></div>
              </div>
            </div>
          </div>

          <!-- Bottom Text Label -->
          <div class="relative z-10 w-full text-center">
            <span class="text-[9px] font-bold text-tiki-soft tracking-[0.25em] uppercase">Estética Ancestral</span>
          </div>
        </div>
      </div>

      <!-- Text Content Column -->
      <div class="lg:col-span-7 order-1 lg:order-2 space-y-8">
        <div class="space-y-4">
          <span class="text-xs font-extrabold uppercase tracking-widest text-tiki-palm bg-tiki-forest/30 border border-tiki-palm/20 px-3.5 py-1 rounded-full inline-block">
            Nuestra Esencia
          </span>
          <h2 class="text-4xl md:text-5xl font-extrabold text-tiki-textMain tracking-tight">
            Sobre Tiki House
          </h2>
        </div>

        <p class="text-base md:text-lg text-tiki-textSec font-normal leading-relaxed">
          Tiki House lleva la experiencia de bar hasta tu evento. Creamos cocteles tropicales, barras personalizadas y momentos memorables con una estética inspirada en la cultura tiki, la frescura de Costa Rica y el ambiente de celebración.
        </p>

        <div class="border-t border-white/5 pt-8 space-y-6">
          <!-- Value Item 1 -->
          <div class="flex items-start space-x-4">
            <div class="p-3 rounded-2xl bg-tiki-card border border-tiki-palm/20 flex-shrink-0 text-tiki-palm">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-11.314l.707.707m11.314 11.314l.707-.707M12 5a7 7 0 100 14 7 7 0 000-14z"></path>
              </svg>
            </div>
            <div>
              <h4 class="text-base font-bold text-tiki-textMain mb-1">Identidad Tropical</h4>
              <p class="text-sm text-tiki-textSec font-normal leading-relaxed">
                Fusionamos el misticismo tiki con la calidez del "Pura Vida" costarricense, garantizando un ambiente festivo, exótico y distinguido.
              </p>
            </div>
          </div>

          <!-- Value Item 2 -->
          <div class="flex items-start space-x-4">
            <div class="p-3 rounded-2xl bg-tiki-card border border-tiki-orange/20 flex-shrink-0 text-tiki-orange">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4Z"></path>
              </svg>
            </div>
            <div>
              <h4 class="text-base font-bold text-tiki-textMain mb-1">Mixología de Autor</h4>
              <p class="text-sm text-tiki-textSec font-normal leading-relaxed">
                Utilizamos jugos naturales, jarabes infusionados de forma artesanal y licores seleccionados para ofrecer cocteles frescos e insuperables.
              </p>
            </div>
          </div>

          <!-- Value Item 3 -->
          <div class="flex items-start space-x-4">
            <div class="p-3 rounded-2xl bg-tiki-card border border-tiki-yellow/20 flex-shrink-0 text-tiki-yellow">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <div>
              <h4 class="text-base font-bold text-tiki-textMain mb-1">Servicio Dedicado e Impecable</h4>
              <p class="text-sm text-tiki-textSec font-normal leading-relaxed">
                Desde el montaje puntual hasta la limpieza final. Nuestro equipo de bartenders certificados asegura que tus invitados sean atendidos con calidez.
              </p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
