---
import type { Package } from '../data/packages';

interface Props {
  pkg: Package;
}

const { pkg } = Astro.props;

const isPopular = pkg.badge === 'Popular';
const isFeatured = pkg.badge === 'Destacado';
const isPremium = pkg.badge?.includes('Premium');
---

<div class={`relative rounded-3xl p-8 flex flex-col justify-between h-full transition-all duration-300 group hover:-translate-y-1.5 hover:shadow-[0_10px_30px_rgba(0,177,137,0.08)] backdrop-blur-sm ${
  isPopular 
    ? 'bg-gradient-to-b from-tiki-card via-tiki-card to-tiki-secondary/30 border-tiki-primary/40 shadow-[0_0_30px_rgba(0,177,137,0.05)] border-2' 
    : isFeatured
    ? 'bg-gradient-to-b from-tiki-card via-tiki-card to-tiki-secondary/30 border-tiki-gold/40 shadow-[0_0_30px_rgba(245,168,0,0.05)] border-2'
    : isPremium
    ? 'bg-gradient-to-b from-tiki-card via-tiki-card to-tiki-secondary/30 border-tiki-accent/40 shadow-[0_0_30px_rgba(240,89,42,0.05)] border-2'
    : 'bg-tiki-card border-tiki-primary/10 border'
}`}>
  <!-- Package Badge -->
  {pkg.badge && (
    <span class={`absolute -top-3.5 right-6 text-[10px] font-extrabold tracking-widest uppercase px-3 py-1 rounded-full border ${
      isPopular 
        ? 'bg-tiki-primary text-tiki-bg border-tiki-primary shadow-[0_0_10px_rgba(0,177,137,0.3)]' 
        : isFeatured
        ? 'bg-tiki-gold text-tiki-bg border-tiki-gold shadow-[0_0_10px_rgba(245,168,0,0.3)]'
        : isPremium
        ? 'bg-tiki-accent text-tiki-text border-tiki-accent shadow-[0_0_10px_rgba(240,89,42,0.3)]'
        : 'bg-tiki-bg text-tiki-text-sec border-tiki-primary/20'
    }`}>
      {pkg.badge}
    </span>
  )}

  <div>
    <!-- Title & Description -->
    <h3 class="text-2xl font-bold text-tiki-text mb-2 group-hover:text-tiki-primary transition-colors duration-300">
      {pkg.name}
    </h3>
    <p class="text-sm text-tiki-text-sec font-normal leading-relaxed mb-6">
      {pkg.description}
    </p>

    <!-- Key Metrics Grid -->
    <div class="grid grid-cols-2 gap-4 p-4 rounded-2xl bg-tiki-bg/60 border border-tiki-primary/10 mb-6">
      <div class="space-y-1">
        <span class="text-[10px] font-bold text-tiki-text-muted uppercase tracking-wider">Invitados</span>
        <p class="text-sm font-semibold text-tiki-text">{pkg.suggestedGuests}</p>
      </div>
      <div class="space-y-1">
        <span class="text-[10px] font-bold text-tiki-text-muted uppercase tracking-wider">Servicio</span>
        <p class="text-sm font-semibold text-tiki-text">{pkg.hoursOfService} Horas</p>
      </div>
      <div class="space-y-1">
        <span class="text-[10px] font-bold text-tiki-text-muted uppercase tracking-wider">Personal</span>
        <p class="text-sm font-semibold text-tiki-text">{pkg.bartendersCount} Bartender{pkg.bartendersCount > 1 ? 's' : ''}</p>
      </div>
      <div class="space-y-1">
        <span class="text-[10px] font-bold text-tiki-text-muted uppercase tracking-wider">Cocteles</span>
        <p class="text-sm font-semibold text-tiki-text">{pkg.cocktailsIncludedCount} Tipos</p>
      </div>
    </div>

    <!-- Included Beverages Details -->
    <div class="mb-6 py-2 px-3 border-l-2 border-tiki-primary/30 bg-tiki-primary/5 rounded-r-xl">
      <p class="text-xs font-semibold text-tiki-primary uppercase tracking-wide mb-0.5">Bebidas Incluidas</p>
      <p class="text-xs text-tiki-text-sec leading-normal">{pkg.cocktailsDescription}</p>
    </div>

    <!-- Features Checklist -->
    <div class="space-y-3.5 mb-8">
      <p class="text-xs font-bold text-tiki-text uppercase tracking-widest">Servicio incluye:</p>
      <ul class="space-y-2.5">
        {pkg.features.map((feature) => (
          <li class="flex items-start space-x-2.5 text-xs text-tiki-text-sec font-normal">
            <svg class="w-4 h-4 text-tiki-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="leading-relaxed">{feature}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Booking CTA -->
  <button 
    data-package-name={pkg.name}
    class={`booking-btn w-full py-4 rounded-xl font-bold text-center tracking-wide transition-all duration-300 cursor-pointer ${
      isPopular 
        ? 'bg-tiki-primary text-tiki-bg hover:bg-tiki-primary-hover shadow-[0_0_20px_rgba(0,177,137,0.2)] hover:shadow-[0_0_30px_rgba(0,177,137,0.4)]'
        : isFeatured
        ? 'bg-tiki-gold text-tiki-bg hover:bg-tiki-gold/90 shadow-[0_0_20px_rgba(245,168,0,0.2)] hover:shadow-[0_0_30px_rgba(245,168,0,0.4)]'
        : isPremium
        ? 'bg-tiki-accent text-tiki-text hover:bg-tiki-accent/90 shadow-[0_0_20px_rgba(240,89,42,0.2)] hover:shadow-[0_0_30px_rgba(240,89,42,0.4)]'
        : 'bg-tiki-bg border border-tiki-primary/20 text-tiki-text hover:bg-tiki-primary/10 hover:border-tiki-primary/45'
    }`}
  >
    Cotizar este paquete
  </button>
</div>
