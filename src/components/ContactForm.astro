---
// Read contact email from environment variable
const contactEmail =
  import.meta.env.PUBLIC_CONTACT_EMAIL || "contacto@tikihouse.cr";
---

<section
  id="contacto"
  class="py-24 px-4 md:px-8 relative bg-tiki-dark overflow-hidden"
>
  <!-- Glowing green neons around the form -->
  <div
    class="absolute top-1/2 left-10 w-80 h-80 bg-tiki-palm/5 rounded-full blur-[120px] pointer-events-none -z-10 animate-pulse"
  >
  </div>
  <div
    class="absolute bottom-10 right-10 w-80 h-80 bg-tiki-orange/5 rounded-full blur-[120px] pointer-events-none -z-10 animate-pulse"
  >
  </div>

  <div class="max-w-4xl mx-auto relative z-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
      <span
        class="text-xs font-extrabold uppercase tracking-widest text-tiki-palm bg-tiki-forest/30 border border-tiki-palm/20 px-3.5 py-1 rounded-full inline-block"
      >
        Hagamos Fiesta
      </span>
      <h2
        class="text-4xl md:text-5xl font-extrabold text-tiki-textMain tracking-tight"
      >
        Reserva tu Fecha
      </h2>
      <p class="text-base text-tiki-textSec font-normal leading-relaxed">
        Completa el formulario para solicitar una cotización formal. Las
        solicitudes se envían directamente a nuestro equipo de atención
        comercial.
      </p>
    </div>

    <!-- Contact Form Container -->
    <div
      class="rounded-3xl glassmorphism p-8 md:p-12 shadow-[0_15px_40px_rgba(5,8,7,0.7)] relative"
    >
      <!-- Target Email Banner -->
      <div
        class="mb-8 p-4 rounded-2xl bg-tiki-palm/5 border border-tiki-palm/20 flex flex-col sm:flex-row items-center justify-between gap-4"
      >
        <div class="flex items-center space-x-3 text-left">
          <div
            class="p-2 rounded-xl bg-tiki-forest text-tiki-palm flex-shrink-0"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L22 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <div>
            <p class="text-xs font-bold text-tiki-textMain">
              Canal de Ventas Oficial
            </p>
            <p class="text-[11px] text-tiki-textSec">
              Tu consulta será remitida directamente a:
            </p>
          </div>
        </div>
        <a
          href={`mailto:${contactEmail}`}
          class="text-xs font-mono font-bold text-tiki-palm hover:underline bg-tiki-dark/65 px-4 py-2 rounded-lg border border-tiki-palm/15 hover:border-tiki-palm/35 transition-all duration-300"
        >
          {contactEmail}
        </a>
      </div>

      <!-- Actual HTML Form -->
      <form id="tiki-booking-form" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Name -->
          <div class="flex flex-col space-y-2">
            <label
              for="nombre"
              class="text-xs font-bold text-tiki-textMain uppercase tracking-wider"
              >Nombre Completo</label
            >
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              placeholder="Ej. Juan Rojas."
              class="w-full px-4 py-3.5 rounded-xl bg-tiki-dark border border-tiki-soft/15 text-tiki-textMain focus:outline-none focus:border-tiki-palm/60 transition-colors duration-300 placeholder:text-tiki-textSec/30 text-sm"
            />
          </div>

          <!-- Email -->
          <div class="flex flex-col space-y-2">
            <label
              for="correo"
              class="text-xs font-bold text-tiki-textMain uppercase tracking-wider"
              >Correo Electrónico</label
            >
            <input
              type="email"
              id="correo"
              name="correo"
              required
              placeholder="correo@ejemplo.com"
              class="w-full px-4 py-3.5 rounded-xl bg-tiki-dark border border-tiki-soft/15 text-tiki-textMain focus:outline-none focus:border-tiki-palm/60 transition-colors duration-300 placeholder:text-tiki-textSec/30 text-sm"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Phone -->
          <div class="flex flex-col space-y-2">
            <label
              for="telefono"
              class="text-xs font-bold text-tiki-textMain uppercase tracking-wider"
              >Teléfono de Contacto</label
            >
            <input
              type="tel"
              id="telefono"
              name="telefono"
              required
              placeholder="Ej. +506 8888-8888"
              class="w-full px-4 py-3.5 rounded-xl bg-tiki-dark border border-tiki-soft/15 text-tiki-textMain focus:outline-none focus:border-tiki-palm/60 transition-colors duration-300 placeholder:text-tiki-textSec/30 text-sm"
            />
          </div>

          <!-- Event Type / Package Selection -->
          <div class="flex flex-col space-y-2">
            <label
              for="tipo-evento"
              class="text-xs font-bold text-tiki-textMain uppercase tracking-wider"
              >Tipo de Servicio / Paquete</label
            >
            <select
              id="tipo-evento"
              name="tipo-evento"
              required
              class="w-full px-4 py-3.5 rounded-xl bg-tiki-dark border border-tiki-soft/15 text-tiki-textMain focus:outline-none focus:border-tiki-palm/60 transition-colors duration-300 text-sm appearance-none cursor-pointer"
            >
              <option value="" disabled selected class="text-tiki-textSec/25"
                >Selecciona una opción</option
              >
              <option
                value="Paquete Ola Tiki"
                class="bg-tiki-dark text-tiki-textMain"
                >Paquete Ola Tiki (Hasta 20 pers.)</option
              >
              <option
                value="Paquete Fuego Tribal"
                class="bg-tiki-dark text-tiki-textMain"
                >Paquete Fuego Tribal (20-50 pers.)</option
              >
              <option
                value="Paquete Paraíso Tropical"
                class="bg-tiki-dark text-tiki-textMain"
                >Paquete Paraíso Tropical (50-100 pers.)</option
              >
              <option
                value="Paquete Experiencia Tiki House"
                class="bg-tiki-dark text-tiki-textMain"
                >Paquete Experiencia Tiki House (100+ pers.)</option
              >
              <option
                value="Evento Personalizado"
                class="bg-tiki-dark text-tiki-textMain"
                >Coctelería a Medida / Corporativo</option
              >
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Event Date -->
          <div class="flex flex-col space-y-2">
            <label
              for="fecha-evento"
              class="text-xs font-bold text-tiki-textMain uppercase tracking-wider"
              >Fecha del Evento</label
            >
            <input
              type="date"
              id="fecha-evento"
              name="fecha-evento"
              required
              class="w-full px-4 py-3.5 rounded-xl bg-tiki-dark border border-tiki-soft/15 text-tiki-textMain focus:outline-none focus:border-tiki-palm/60 transition-colors duration-300 text-sm cursor-pointer"
            />
          </div>

          <!-- Guests Count -->
          <div class="flex flex-col space-y-2">
            <label
              for="cantidad-invitados"
              class="text-xs font-bold text-tiki-textMain uppercase tracking-wider"
              >Invitados Aproximados</label
            >
            <input
              type="number"
              id="cantidad-invitados"
              name="cantidad-invitados"
              required
              min="1"
              placeholder="Ej. 65"
              class="w-full px-4 py-3.5 rounded-xl bg-tiki-dark border border-tiki-soft/15 text-tiki-textMain focus:outline-none focus:border-tiki-palm/60 transition-colors duration-300 placeholder:text-tiki-textSec/30 text-sm"
            />
          </div>
        </div>

        <!-- Message -->
        <div class="flex flex-col space-y-2">
          <label
            for="mensaje"
            class="text-xs font-bold text-tiki-textMain uppercase tracking-wider"
            >Detalles Adicionales / Mensaje</label
          >
          <textarea
            id="mensaje"
            name="mensaje"
            rows="5"
            placeholder="Cuéntanos más sobre el tipo de celebración, lugar exacto del evento, si hay requerimientos especiales de bebidas..."
            class="w-full px-4 py-3.5 rounded-xl bg-tiki-dark border border-tiki-soft/15 text-tiki-textMain focus:outline-none focus:border-tiki-palm/60 transition-colors duration-300 placeholder:text-tiki-textSec/30 text-sm resize-none"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <div class="pt-4">
          <button
            type="submit"
            class="w-full py-4 rounded-xl bg-tiki-palm hover:bg-tiki-palm/90 text-tiki-dark font-extrabold text-sm tracking-widest uppercase shadow-[0_0_20px_rgba(45,212,126,0.25)] hover:shadow-[0_0_35px_rgba(45,212,126,0.55)] transition-all duration-300 cursor-pointer transform hover:-translate-y-0.5"
          >
            Enviar Solicitud de Cotización
          </button>
        </div>
      </form>

      <!-- Success / Response Messages -->
      <div
        id="form-success-alert"
        class="hidden absolute inset-0 bg-tiki-dark/95 border border-tiki-palm/35 rounded-3xl z-20 flex flex-col items-center justify-center p-8 text-center animate-fade-in"
      >
        <div
          class="w-16 h-16 rounded-full bg-tiki-palm/15 border border-tiki-palm/35 flex items-center justify-center text-tiki-palm mb-6"
        >
          <svg
            class="w-8 h-8"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-tiki-textMain mb-3">
          ¡Solicitud Registrada!
        </h3>
        <p class="text-sm text-tiki-textSec max-w-md mb-8 leading-relaxed">
          Gracias por contactar a Tiki House. Hemos simulado el envío de esta
          cotización al correo configurado en nuestras variables de entorno: <strong
            class="text-tiki-palm text-xs block font-mono mt-1"
            >{contactEmail}</strong
          >
        </p>
        <button
          id="form-reset-btn"
          class="px-6 py-2.5 rounded-xl border border-tiki-palm/20 hover:border-tiki-palm text-tiki-palm font-bold text-xs uppercase tracking-wider transition-colors duration-300 cursor-pointer"
        >
          Enviar Otro Mensaje
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById(
    "tiki-booking-form",
  ) as HTMLFormElement | null;
  const successAlert = document.getElementById("form-success-alert");
  const resetBtn = document.getElementById("form-reset-btn");

  if (form && successAlert) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      // Extract form data for logging/validation
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      console.log("Sending event inquiry payload:", data);

      // Show success screen
      successAlert.classList.remove("hidden");
      successAlert.classList.add("flex");
    });
  }

  if (resetBtn && successAlert && form) {
    resetBtn.addEventListener("click", () => {
      form.reset();
      successAlert.classList.remove("flex");
      successAlert.classList.add("hidden");
    });
  }
</script>

<style>
  /* Custom date and select styles for dark background */
  input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(0.9) sepia(100%) saturate(1000%) hue-rotate(100deg);
  }

  select {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%232DD47E' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 1rem center;
    background-repeat: no-repeat;
    background-size: 1.25em 1.25em;
  }
</style>
