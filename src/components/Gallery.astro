---
const items = [
  {
    id: 'barra-cocteles',
    title: 'La Estación Principal',
    category: 'Barra de Cocteles',
    description: 'Montaje completo de nuestra barra móvil iluminada, lista para recibir a tus invitados.',
    span: 'md:col-span-2 md:row-span-2',
  },
  {
    id: 'evento-nocturno',
    title: 'Celebraciones Nocturnas',
    category: 'Evento Nocturno',
    description: 'Ambiente festivo y sofisticado bajo las luces de la noche costarricense.',
    span: 'md:col-span-1 md:row-span-1',
  },
  {
    id: 'bebidas-tropicales',
    title: 'Destilados Exóticos',
    category: 'Bebidas Tropicales',
    description: 'Servicio continuo de tragos decorados con flores, frutas frescas y sorbetes ecológicos.',
    span: 'md:col-span-1 md:row-span-2',
  },
  {
    id: 'bartender-preparando',
    title: 'Mixología en Vivo',
    category: 'Bartender Preparando Tragos',
    description: 'Profesionales de la coctelería ejecutando técnicas de agitado y servido con precisión y estilo.',
    span: 'md:col-span-1 md:row-span-1',
  },
  {
    id: 'decoracion-tiki',
    title: 'El Arte del Detalle',
    category: 'Decoración Tiki',
    description: 'Tiki mugs artesanales, luces cálidas, y follaje selvático para ambientar tu celebración.',
    span: 'md:col-span-2 md:row-span-1',
  }
];
---

<section id="galeria" class="py-24 px-4 md:px-8 relative bg-tiki-bg overflow-hidden">
  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="text-xs font-extrabold uppercase tracking-widest text-tiki-primary bg-tiki-secondary/30 border border-tiki-primary/20 px-3.5 py-1 rounded-full inline-block">
        Visualiza tu Evento
      </span>
      <h2 class="text-4xl md:text-5xl font-extrabold text-tiki-text tracking-tight">
        Galería de Experiencias
      </h2>
      <p class="text-base md:text-lg text-tiki-text-sec font-normal leading-relaxed">
        Un vistazo a la atmósfera, el servicio y los detalles exóticos que llevamos a cada una de nuestras celebraciones.
      </p>
    </div>

    <!-- Bento Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[200px] md:auto-rows-[220px]">
      {items.map((item) => (
        <div class={`group relative rounded-3xl p-6 md:p-8 bg-tiki-card border border-tiki-primary/15 flex flex-col justify-between overflow-hidden transition-all duration-500 hover:-translate-y-1 hover:shadow-[0_10px_35px_rgba(0,177,137,0.1)] hover:border-tiki-primary/35 ${item.span}`}>
          
          <!--
            ╔══════════════════════════════════════════════════════════════╗
            ║  IMAGEN DE GALERÍA                                          ║
            ║  Subir imagen a: /public/images/gallery/{item.id}.jpg       ║
            ║  Tamaño recomendado: 800x600px mínimo                       ║
            ║  Los items grandes (col-span-2) usar 1200x800px             ║
            ╚══════════════════════════════════════════════════════════════╝
          -->
          <!-- Background Image -->
          <img 
            src={`/images/gallery/${item.id}.jpg`}
            alt={item.title}
            class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-50 transition-opacity duration-500"
            loading="lazy"
          />

          <!-- Overlay gradiente oscuro -->
          <div class="absolute inset-0 bg-gradient-to-t from-tiki-bg via-tiki-bg/70 to-transparent"></div>

          <!-- Top Section (Category) -->
          <div class="flex items-start justify-between relative z-10">
            <span class="text-[10px] font-bold tracking-widest uppercase text-tiki-primary bg-tiki-bg/65 border border-tiki-primary/20 px-3 py-1 rounded-full">
              {item.category}
            </span>
          </div>

          <!-- Bottom Section (Title & Description) -->
          <div class="relative z-10">
            <h3 class="text-xl md:text-2xl font-bold text-tiki-text mb-1.5 group-hover:text-tiki-primary transition-colors duration-300">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-tiki-text-sec font-normal leading-relaxed max-w-xl opacity-80 group-hover:opacity-100 transition-opacity duration-300">
              {item.description}
            </p>
          </div>

          <!-- Glassmorphic neon-like border glow -->
          <div class="absolute inset-0 border border-tiki-primary/0 group-hover:border-tiki-primary/20 rounded-3xl transition-colors duration-500 pointer-events-none"></div>
        </div>
      ))}
    </div>
  </div>
</section>
