---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = "Tiki House Costa Rica | Coctelería Tropical y Barra Móvil para Eventos",
  description = "Disfruta de la mejor barra libre de coctelería tropical y tiki para tus eventos en Costa Rica. Cocteles premium, bartenders profesionales y barras móviles temáticas para bodas, fiestas privadas y corporativos.",
  keywords = "cocteleria Costa Rica, barra movil Costa Rica, barman para eventos, bartenders Costa Rica, cocteles para bodas, fiestas privadas, tiki bar Costa Rica, catering de bebidas, chiliguaro, guaro cacique, bebidas para fiestas"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://tikihouse.cr');
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Tiki House Costa Rica" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://tikihouse.cr/og-image.jpg" />
    <meta property="og:locale" content="es_CR" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://tikihouse.cr/og-image.jpg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Syne:wght@500;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-tiki-dark text-tiki-textMain font-sans antialiased min-h-screen selection:bg-tiki-palm selection:text-tiki-dark overflow-x-hidden">
    <!-- Base premium neon glow effects on background -->
    <div class="fixed top-0 left-0 w-full h-full pointer-events-none z-0 overflow-hidden bg-[#050807]">
      <div class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] rounded-full bg-tiki-forest/15 blur-[150px]"></div>
      <div class="absolute top-[30%] -right-[15%] w-[60%] h-[60%] rounded-full bg-tiki-palm/5 blur-[180px]"></div>
      <div class="absolute -bottom-[10%] left-[20%] w-[45%] h-[45%] rounded-full bg-tiki-orange/5 blur-[150px]"></div>
    </div>

    <!-- Main Content Wrapper -->
    <div class="relative z-10 flex flex-col min-h-screen justify-between">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  /* Extra details for premium typography and layout */
  h1, h2, h3, h4, h5, h6 {
    font-family: 'Syne', sans-serif;
    letter-spacing: -0.02em;
  }
  
  /* Smooth animations helper */
  .transition-all-custom {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>
